{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check main.ts client.ts utils.ts vite.config.ts debug.ts deno.json assets routes components islands runtime tests && deno lint main.ts client.ts utils.ts vite.config.ts debug.ts routes components islands runtime tests && deno check",
    "test": "deno test -A",
    "dev": "deno task --env-file dev:server",
    "dev:server": "vite",
    "build": "vite build",
    "start": "deno task --env-file start:server",
    "start:server": "deno serve -A --host=$(deno run --allow-env=PORTAL_BIND runtime/bind.ts) _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    "**/.planning/*"
  ],
  "imports": {
    "@/": "./",
    "@kehto/nip": "npm:@kehto/nip@0.5.1",
    "@kehto/runtime": "npm:@kehto/runtime@0.20.1",
    "@kehto/services": "npm:@kehto/services@0.18.1",
    "@kehto/shell": "npm:@kehto/shell@0.19.1",
    "@libs/qrcode": "jsr:@libs/qrcode@3.1.0",
    "@napplet/core": "npm:@napplet/core@0.31.0",
    "@napplet/nap": "npm:@napplet/nap@0.31.0",
    "applesauce-accounts": "npm:applesauce-accounts@6.2.0",
    "applesauce-core": "npm:applesauce-core@6.2.0",
    "applesauce-relay": "npm:applesauce-relay@6.2.1",
    "applesauce-signers": "npm:applesauce-signers@6.2.2",
    "fresh": "jsr:@fresh/core@2.3.3",
    "nostr-tools": "npm:nostr-tools@2.24.1",
    "preact": "npm:preact@^10.29.7",
    "@preact/signals": "npm:@preact/signals@^2.10.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@1.1.2",
    "@grammyjs/debug": "jsr:@grammyjs/debug@^0.3.1",
    "debug": "./runtime/debug_compat.ts",
    "vite": "npm:vite@^7.3.6",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
