# Napplet Portal environment file.
#
# Copy this file to `.env`, then edit it:
#
#   cp .env.example .env
#
# `deno task dev` and `deno task start` load `.env` from the project root.
# Real environment variables win: a value already exported in the shell is never
# overwritten by this file. Configuration is read once at startup, so restart
# the process after changing it. `.env` is gitignored; `.env.example` is not, so
# keep real values, credentials, and private endpoints out of this file.
#
# Every setting below is optional except NAPPLET_COORDINATE, and every value
# shown is the built-in default. Uncomment the ones you want to change.

# Required NIP-5D `naddr` for the one active napplet. Empty until configured,
# and Home explains how to set it.
NAPPLET_COORDINATE=

# Comma-separated `ws:`/`wss:` relay URLs. Setting this replaces the built-in
# fallback list rather than adding to it. Local relays are ordinary entries:
# list local and public URLs together when both should be tried. URLs are
# normalized and deduplicated, and invalid entries are rejected with a warning
# while the remaining valid entries continue to load.
# NOSTR_RELAYS=wss://relay.damus.io/,wss://nos.lol/

# NIP-46 remote signer transport relays. Replaces the built-in list.
# REMOTE_SIGNER_RELAYS=wss://bucket.coracle.social/

# Comma-separated `http:`/`https:` Blossom server bases. Replaces the built-in
# list. Manifest-provided hints are merged with these, and every blob is
# verified rather than trusted.
# BLOSSOM_SERVERS=https://blossom.primal.net/,https://blossom.band/

# Detached-tab retention in milliseconds, from 1000 through 120000. Values
# outside that range are rejected with a warning and fall back to the default.
# PORTAL_RECONNECT_GRACE_MS=10000

# Server bind address. Only `127.0.0.1` and `::1` are accepted; anything else is
# rejected with a warning and falls back to `127.0.0.1`. Anyone who can reach
# this server acts as the same trusted operator and shares the backend's active
# signer, so do not expose it to a LAN or the internet without adding a trusted
# access boundary of your own.
# PORTAL_BIND=127.0.0.1

# No credentials belong in any endpoint URL above. Userinfo is stripped from
# configured URLs, but host-level secret controls still apply.
